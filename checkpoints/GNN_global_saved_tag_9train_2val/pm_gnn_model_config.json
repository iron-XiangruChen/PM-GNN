    "Area [cm^2]",
    "EqRadius [cm]",
    "X Coord [cm]",
    "Y Coord [cm]",
    "Z Coord [cm]",
    "Coordination Number"
  ],
  "edge_feature_cols": [
    "Area [cm^2]",
    "EqRadius [cm]",
    "ChannelLength [cm]"
  ],
  "global_feature_cols": [
    "porosity",
    "connected_porosity",
    "num_pores",
    "num_throats",
    "percolates_x",
    "percolates_y",
    "percolates_z",
    "connected_porosity_x",
    "connected_porosity_y",
    "connected_porosity_z",
    "solid_fraction",
    "solid_connected_fraction_x",
    "solid_connected_fraction_y",
    "solid_connected_fraction_z",
    "solid_skeleton_percolates_x",
    "solid_skeleton_percolates_y",
    "solid_skeleton_percolates_z",
    "solid_skeleton_percolating_components_x",
    "solid_skeleton_percolating_components_y",
    "solid_skeleton_percolating_components_z",
    "graph_num_pores",
    "graph_num_throats",
    "graph_edge_density",
    "graph_mean_degree",
    "graph_std_degree",
    "graph_max_degree",
    "graph_mean_pore_radius",
    "graph_std_pore_radius",
    "graph_max_pore_radius",
    "graph_mean_throat_radius",
    "graph_std_throat_radius",
    "graph_max_throat_radius",
    "graph_mean_throat_length",
    "graph_std_throat_length",
    "graph_max_throat_length",
    "graph_bbox_x",
    "graph_bbox_y",
    "graph_bbox_z",
    "graph_bbox_volume",
    "primary_dir_is_x",
    "primary_dir_is_y",
    "primary_dir_is_z"
