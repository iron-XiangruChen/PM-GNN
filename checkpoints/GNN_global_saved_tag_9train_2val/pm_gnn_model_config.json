{
  "model_name": "PM-GNN",
  "definition": "GNN + global_descriptors; no enhanced_MP",
  "hidden_dim": 64,
  "num_layers": 2,
  "dropout": 0.1,
  "use_global_descriptors": true,
  "use_enhanced_mp": false,
  "node_feature_cols": [
